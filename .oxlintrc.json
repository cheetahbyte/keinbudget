{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["src/hooks/usePaginatedItems.ts"],
      "rules": { "react/set-state-in-effect": "warn" }
    },
    {
      "files": ["src/components/SalaryBar.tsx", "src/components/ui/field.tsx"],
      "rules": { "jsx-a11y/prefer-tag-over-role": "off" }
    },
    {
      "files": [
        "src/components/ui/pagination.tsx",
        "src/sections/StatsSection.test.tsx"
      ],
      "rules": { "jsx-a11y/anchor-has-content": "off" }
    }
  ],
  "ignorePatterns": [
    "**/node_modules",
    "**/.next",
    "**/public",
    "**/.wrangler",
    "**/dist",
    "**/icons",
    "**/patches",
    "src/routeTree.gen.ts"
  ]
}
